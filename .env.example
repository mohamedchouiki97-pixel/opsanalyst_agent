# Copy to .env and fill in. Every value here has a safe default in agent/config.py,
# so you only need to set what you want to change.

# --- Dataset (folder name under datasets/) ---
DATASET=tpch

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://opsanalyst:opsanalyst_dev@localhost:5432/opsanalyst

# --- LLM ---
# fake = scripted answers, costs $0 (default)
# openai = real OpenAI API calls (costs money)
# azure_openai = Phase 6 only
LLM_PROVIDER=fake
OPENAI_API_KEY=
MODEL_STRONG=gpt-4.1
MODEL_CHEAP=gpt-4.1-mini

# --- Spending caps (USD) ---
MAX_USD_PER_QUESTION=0.25
MAX_USD_PER_DAY=2.00
